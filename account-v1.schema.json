{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hero Wars Advisor Account Export",
  "type": "object",
  "required": [
    "schemaVersion",
    "exportedAt",
    "account"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "exportedAt": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "account": {
      "type": "object",
      "required": [
        "meta",
        "heroes",
        "titans"
      ]
    }
  }
}